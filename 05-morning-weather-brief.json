{
  "name": "Morning Weather Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "57c4de6c-db7a-4cab-8280-125684e9e2b0",
      "name": "Every Morning 7:00"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "1c77bf1b-a1e3-4fb3-87de-25b39c1b083e",
      "name": "Manual Test"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "31.2001"
            },
            {
              "name": "longitude",
              "value": "29.9187"
            },
            {
              "name": "current",
              "value": "temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            },
            {
              "name": "timezone",
              "value": "Africa/Cairo"
            },
            {
              "name": "forecast_days",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        260,
        100
      ],
      "id": "e37e9cc3-db62-41be-9cc8-29a0890b82ed",
      "name": "Get Alexandria Forecast"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5b1a73f3-c840-40d6-b32d-047bc161feda",
              "name": "location",
              "value": "Alexandria, Egypt",
              "type": "string"
            },
            {
              "id": "2957ad5a-838a-411d-b242-c1f2ba33998e",
              "name": "nowC",
              "value": "={{ $json.current.temperature_2m }}",
              "type": "number"
            },
            {
              "id": "57b647d3-7b6a-474f-b4d4-91a915d105d0",
              "name": "maxC",
              "value": "={{ $json.daily.temperature_2m_max[0] }}",
              "type": "number"
            },
            {
              "id": "09f9ef74-b707-4a96-ad54-148fe68acd97",
              "name": "minC",
              "value": "={{ $json.daily.temperature_2m_min[0] }}",
              "type": "number"
            },
            {
              "id": "1ab54656-88dc-4f9e-bd24-74fe1ccd85f2",
              "name": "rainChance",
              "value": "={{ $json.daily.precipitation_probability_max[0] }}",
              "type": "number"
            },
            {
              "id": "6f272db4-4177-4ed0-a69e-b8636945a898",
              "name": "message",
              "value": "={{ \"Good morning! Alexandria now: \" + $json.current.temperature_2m + \"°C (feels \" + $json.current.apparent_temperature + \"°C). Today \" + $json.daily.temperature_2m_min[0] + \"–\" + $json.daily.temperature_2m_max[0] + \"°C, rain chance \" + $json.daily.precipitation_probability_max[0] + \"%.\" + ($json.daily.precipitation_probability_max[0] >= 40 ? \" Take an umbrella.\" : \"\") }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        520,
        100
      ],
      "id": "c6010fe6-733f-43d4-9a5c-ecafd549e52a",
      "name": "Build Morning Brief"
    }
  ],
